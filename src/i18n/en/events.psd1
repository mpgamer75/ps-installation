@{
    'Que s''est-il passé sur cette machine ? Les événements Windows qui comptent.' = 'What happened on this machine? The Windows events that matter.'
    'events [-Hours <n>] [-Level error|warn|all] [-Log <journaux>] [-Top <n>]' = 'events [-Hours <n>] [-Level error|warn|all] [-Log <logs>] [-Top <n>]'
    'events -Id <n>      détail du dernier événement portant cet identifiant' = 'events -Id <n>      details of the latest event with this ID'
    'Période analysée en heures (défaut : 24)' = 'Period to scan, in hours (default: 24)'
    'error : critiques et erreurs · warn : + avertissements (défaut) · all : tout' = 'error: critical and errors · warn: + warnings (default) · all: everything'
    '-Log <journaux>' = '-Log <logs>'
    'Journaux lus (défaut : System,Application)' = 'Logs to read (default: System,Application)'
    'Nombre de groupes affichés (défaut : 15)' = 'Number of groups shown (default: 15)'
    'Affiche le message complet d''un événement' = 'Show the full message of an event'
    'Sortie JSON, pour les scripts' = 'JSON output, for scripts'
    'events -Json | ask "y a-t-il un problème sérieux ?"' = 'events -Json | ask "is there a serious problem?"'
    '(message indisponible)' = '(message unavailable)'
    'événement {0}' = 'event {0}'
    'Aucun événement {0} sur les {1} dernières heures.' = 'No event {0} in the last {1} hours.'
    '{0} {1} {2} {1} {3} {1} {4} occurrence(s)' = '{0} {1} {2} {1} {3} {1} {4} occurrence(s)'
    'dd/MM/yyyy HH:mm:ss' = 'MM/dd/yyyy HH:mm:ss'
    '{0} dernières heures {1} {2}' = 'last {0} hours {1} {2}'
    '{0} erreur(s)' = '{0} error(s)'
    '{0} {1} avertissement(s) {0} {2} événement(s) au total' = '{0} {1} warning(s) {0} {2} event(s) in total'
    'Journal « {0} » illisible (droits administrateur requis, ou journal inexistant).' = 'Cannot read log "{0}" (administrator rights required, or the log does not exist).'
    'Rien à signaler sur la période.' = 'Nothing to report for this period.'
    'dd/MM HH:mm' = 'MM/dd HH:mm'
    'Niv.' = 'Lvl'
    'Nb' = 'Count'
    'Dernier' = 'Last'
    'events -Id <ID> pour le message complet {0} events -Json | ask "que faut-il corriger ?"' = 'events -Id <ID> for the full message {0} events -Json | ask "what should I fix?"'
}
