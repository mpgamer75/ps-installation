@{
    'Crée des rappels et vous notifie au bon moment.' = 'Creates reminders and notifies you at the right time.'
    'remind                                 menu interactif' = 'remind                                 interactive menu'
    'remind add "<texte>" -In <durée>       dans 15m, 2h, 1j, 1h30...' = 'remind add "<text>" -In <delay>        in 15m, 2h, 1d, 1h30...'
