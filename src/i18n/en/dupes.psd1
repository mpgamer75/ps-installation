@{
    'Trouve les fichiers en double (même contenu) et libère l''espace perdu.' = 'Finds duplicate files (same content) and reclaims the wasted space.'
    'dupes [dossier] [-Min <taille>] [-Include <motifs>] [-Keep oldest|newest|shortest] [-DryRun] [-Yes] [-Json]' = 'dupes [folder] [-Min <size>] [-Include <patterns>] [-Keep oldest|newest|shortest] [-DryRun] [-Yes] [-Json]'
    'dossier' = 'folder'
    'Dossier à analyser, sous-dossiers compris (défaut : dossier courant)' = 'Folder to scan, subfolders included (default: current folder)'
    '-Min <taille>' = '-Min <size>'
    'Taille minimale, ex. : 1MB, 500K, 2Go (défaut : 1 octet)' = 'Minimum size, e.g. 1MB, 500K, 2GB (default: 1 byte)'
    '-Include <motifs>' = '-Include <patterns>'
    'Motifs de fichiers, ex. : *.jpg,*.png' = 'File patterns, e.g. *.jpg,*.png'
    '-Keep <règle>' = '-Keep <rule>'
    'Copie gardée par défaut : oldest (plus ancienne), newest, shortest' = 'Copy kept by default: oldest, newest, shortest (path)'
    'Nombre de groupes affichés (défaut : 20)' = 'Number of groups shown (default: 20)'
    'Affiche ce qui serait supprimé, sans rien toucher' = 'Shows what would be deleted, without touching anything'
    'Supprime sans question en gardant la copie par défaut' = 'Deletes without asking, keeping the default copy'
    'Sortie JSON, pour les scripts (aucune suppression)' = 'JSON output for scripts (nothing is deleted)'
    'dupes . -Json | ask "lesquels supprimer ?"' = 'dupes . -Json | ask "which ones should I delete?"'
    'Copie gardée par défaut : la plus ancienne, puis le chemin le plus court.' = 'Copy kept by default: the oldest, then the shortest path.'
    'Les fichiers supprimés partent à la Corbeille (suppression définitive hors Windows).' = 'Deleted files go to the Recycle Bin (permanent deletion outside Windows).'
    'Taille invalide : « {0} » (ex. : 1MB, 500K).' = 'Invalid size: "{0}" (e.g. 1MB, 500K).'
    'Règle inconnue : « {0} » (oldest, newest ou shortest).' = 'Unknown rule: "{0}" (oldest, newest or shortest).'
    'Argument inattendu : {0}' = 'Unexpected argument: {0}'
    'Dossier introuvable : {0}' = 'Folder not found: {0}'
    'Analyse des fichiers...' = 'Scanning files...'
    'Empreintes : {0}/{1}' = 'Hashing: {0}/{1}'
    'doublons' = 'duplicates'
    'simulation' = 'dry run'
    '{0} fichier(s) examiné(s)' = '{0} file(s) scanned'
    '{0} dossier(s) inaccessible(s) ignoré(s).' = '{0} inaccessible folder(s) skipped.'
    '{0} fichier(s) illisible(s) ignoré(s) (ouverts ou protégés).' = '{0} unreadable file(s) skipped (open or protected).'
    'Aucun doublon trouvé.' = 'No duplicates found.'
    '{0} copies de {1} {2} {3} perdus' = '{0} copies of {1} {2} {3} wasted'
    'garder' = 'keep'
    'supprimer' = 'delete'
    '... et {0} autre(s) groupe(s) (-Top pour en voir davantage)' = '... and {0} more group(s) (use -Top to see more)'
    '{0} groupe(s) de doublons {1} {2} copie(s) en trop {1} {3} récupérables' = '{0} duplicate group(s) {1} {2} redundant file(s) {1} {3} reclaimable'
    'Simulation : aucun fichier supprimé.' = 'Dry run: no files deleted.'
    'Session non interactive : ajoutez -Yes pour supprimer (copie par défaut gardée).' = 'Non-interactive session: add -Yes to delete (the default copy is kept).'
    'Que faire des doublons ?' = 'What should be done with the duplicates?'
    'Choisir la copie à garder, groupe par groupe' = 'Choose the copy to keep, group by group'
    'Garder la copie proposée partout' = 'Keep the suggested copy everywhere'
    'Ne rien supprimer' = 'Delete nothing'
    'Annulé, rien n''a été supprimé.' = 'Cancelled, nothing was deleted.'
    'Garder toutes les copies' = 'Keep all copies'
    'Groupe {0}/{1} {2} {3} : quelle copie garder ?' = 'Group {0}/{1} {2} {3}: which copy should be kept?'
    'Rien à supprimer.' = 'Nothing to delete.'
    'Envoyer {0} fichier(s) ({1}) à la Corbeille ?' = 'Send {0} file(s) ({1}) to the Recycle Bin?'
    'Supprimer définitivement {0} fichier(s) ({1}) ?' = 'Permanently delete {0} file(s) ({1})?'
    '{0} fichier(s) supprimé(s) {1} {2} libérés' = '{0} file(s) deleted {1} {2} freed'
    'Récupérables depuis la Corbeille.' = 'Recoverable from the Recycle Bin.'
    '{0} fichier(s) conservé(s) (modifiés, ouverts ou protégés)' = '{0} file(s) kept (changed, open or protected)'
    'Doublons supprimés' = 'Duplicates removed'
}
