@{
    'Range un dossier en vrac par type de fichier ou par mois, avec annulation.' = 'Sorts a messy folder by file type or by month, with undo.'
    'tidy [dossier] [-By Type|Date] [-OlderThan <jours>] [-DryRun] [-Yes]' = 'tidy [folder] [-By Type|Date] [-OlderThan <days>] [-DryRun] [-Yes]'
    'tidy -Undo [-DryRun] [-Yes]       remet en place le dernier rangement' = 'tidy -Undo [-DryRun] [-Yes]       puts the last run back in place'
    'dossier' = 'folder'
    'Dossier à ranger (défaut : Téléchargements)' = 'Folder to tidy (default: Downloads)'
    'Par catégorie (défaut) ou par mois de modification (2026-11)' = 'By category (default) or by month modified (2026-11)'
    '-OlderThan <jours>' = '-OlderThan <days>'
    'Seulement les fichiers non modifiés depuis N jours' = 'Only files not modified for N days'
    'Affiche l''aperçu sans rien déplacer' = 'Shows the preview without moving anything'
    'Range sans demander de confirmation' = 'Tidies without asking for confirmation'
    'Annule le dernier rangement (journal dans le dossier de données)' = 'Undoes the last run (journal kept in the data folder)'
    'Plan de rangement en JSON, sans rien déplacer' = 'Tidy plan as JSON, without moving anything'
    'Seul le premier niveau est trié : les sous-dossiers existants ne sont pas touchés.' = 'Only the top level is sorted: existing subfolders are left alone.'
    'Jamais d''écrasement : en cas de doublon de nom, « (2) », « (3) »... est ajouté.' = 'Nothing is ever overwritten: on a name clash, "(2)", "(3)"... is appended.'
    'Ignorés : téléchargements en cours (.crdownload, .part, .tmp), fichiers ouverts et cachés.' = 'Skipped: unfinished downloads (.crdownload, .part, .tmp), open and hidden files.'
    'Images' = 'Images'
    'Documents' = 'Documents'
    'Vidéos' = 'Videos'
    'Musique' = 'Music'
    'Archives' = 'Archives'
    'Installateurs' = 'Installers'
    'Code' = 'Code'
    'Autres' = 'Other'
    'Fichiers' = 'Files'
    'Taille' = 'Size'
    'Destination' = 'Folder'
    'annulation' = 'undo'
    'Aucun rangement à annuler.' = 'Nothing to undo.'
    'dddd d MMMM yyyy à HH:mm' = 'dddd, MMMM d, yyyy "at" HH:mm'
    'Dernier rangement : {0} {1} {2}' = 'Last run: {0} {1} {2}'
    '{0} fichier(s) à remettre en place ({1} introuvable(s)).' = '{0} file(s) to put back ({1} missing).'
    '... et {0} autre(s)' = '... and {0} more'
    'Simulation : aucun fichier déplacé.' = 'Dry run: no files moved.'
    'Remettre {0} fichier(s) à leur place ?' = 'Put {0} file(s) back where they were?'
    'Session non interactive : ajoutez -Yes pour annuler le rangement.' = 'Non-interactive session: add -Yes to undo the run.'
    'Annulé, rien n''a été déplacé.' = 'Cancelled, nothing was moved.'
    '{0} fichier(s) remis en place.' = '{0} file(s) put back.'
    '{0} fichier(s) renommé(s) car le nom d''origine était repris.' = '{0} file(s) renamed because the original name was taken.'
    '{0} fichier(s) non déplacé(s) (ouverts ou protégés) : relancez « tidy -Undo ».' = '{0} file(s) not moved (open or protected): run "tidy -Undo" again.'
    'Mode inconnu : « {0} » (Type ou Date).' = 'Unknown mode: "{0}" (Type or Date).'
    'Argument inattendu : {0}' = 'Unexpected argument: {0}'
    'Dossier introuvable : {0}' = 'Folder not found: {0}'
    'Dossier refusé par sécurité (racine ou dossier système) : {0}' = 'Folder refused for safety (drive root or system folder): {0}'
    'Lecture impossible : {0}' = 'Cannot read: {0}'
    'par type' = 'by type'
    'par mois' = 'by month'
    'simulation' = 'dry run'
    '{0} téléchargement(s) en cours ignoré(s)' = '{0} unfinished download(s) skipped'
    '{0} fichier(s) ouvert(s) ignoré(s)' = '{0} open file(s) skipped'
    '{0} fichier(s) récent(s) ignoré(s) (moins de {1} jour(s))' = '{0} recent file(s) skipped (less than {1} day(s) old)'
    '{0} fichier(s) caché(s) ou système ignoré(s)' = '{0} hidden or system file(s) skipped'
    'Rien à ranger : aucun fichier libre au premier niveau.' = 'Nothing to tidy: no loose files at the top level.'
    '{0} fichier(s) à ranger {1} {2}' = '{0} file(s) to tidy {1} {2}'
    'Ranger {0} fichier(s) dans {1} dossier(s) ?' = 'Move {0} file(s) into {1} folder(s)?'
    'Session non interactive : ajoutez -Yes pour ranger.' = 'Non-interactive session: add -Yes to tidy.'
    '{0} fichier(s) rangé(s)' = '{0} file(s) tidied'
    '{0} renommé(s) pour ne rien écraser' = '{0} renamed to avoid overwriting'
    '{0} non déplacé(s) (ouverts ou protégés)' = '{0} not moved (open or protected)'
    'Annuler : tidy -Undo' = 'To undo: tidy -Undo'
    'Rangement terminé' = 'Tidy complete'
}
