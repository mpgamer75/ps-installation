@{
    'Surveille la latence de plusieurs hôtes en même temps.' = 'Monitor latency to several hosts at once.'
    'ping-mon [hôtes...] [-Interval <s>] [-Count <n>] [-Timeout <ms>]' = 'ping-mon [hosts...] [-Interval <s>] [-Count <n>] [-Timeout <ms>]'
    'hôtes' = 'hosts'
    'Noms ou adresses IP (défaut : passerelle, 1.1.1.1, 8.8.8.8, google.com)' = 'Names or IP addresses (default: gateway, 1.1.1.1, 8.8.8.8, google.com)'
    'Délai entre deux séries de pings (défaut : 1)' = 'Delay between ping rounds (default: 1)'
    'Nombre de séries puis bilan (défaut : 0 = illimité)' = 'Number of rounds before the summary (default: 0 = unlimited)'
    'Délai d''attente d''une réponse (défaut : 1500)' = 'Reply timeout (default: 1500)'
    'Touches : Q quitter · R remettre les statistiques à zéro' = 'Keys: Q quit · R reset statistics'
    'Passerelle' = 'Gateway'
    'envoi impossible' = 'could not send'
    'perdu' = 'lost'
    'Hôte' = 'Host'
    'Dernier' = 'Last'
    'Moy' = 'Avg'
    'Gigue' = 'Jitter'
    'Pertes' = 'Loss'
    'Historique' = 'History'
    '{0} hôte(s) {1} toutes les {2}s' = '{0} host(s) {1} every {2}s'
    'bilan' = 'summary'
    'Q quitter {0} R remise à zéro {0} série n° {1}' = 'Q quit {0} R reset {0} round {1}'
}
