@{
    'Observe la sortie d''une commande dans le temps.' = 'Watches the output of a command over time.'
    'watch [-Interval <s>] [-Count <n>] [-NoDiff] <commande>' = 'watch [-Interval <s>] [-Count <n>] [-NoDiff] <command>'
    'Délai entre deux exécutions (défaut : 2)' = 'Seconds between runs (default: 2)'
    'Nombre d''exécutions (défaut : 0 = jusqu''à Q)' = 'Number of runs (default: 0 = until Q)'
    'Ne surligne pas les lignes modifiées' = 'Don''t highlight changed lines'
    'Touches : Q quitter · Espace relancer tout de suite' = 'Keys: Q quit · Space run again now'
    'Erreur : {0}' = 'Error: {0}'
    'toutes les {1}s {0} exécution n° {2} {0} {3} changement(s) {0} {4} {0} Q quitter' = 'every {1}s {0} run #{2} {0} {3} change(s) {0} {4} {0} Q quit'
}
