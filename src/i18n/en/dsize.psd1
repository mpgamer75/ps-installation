@{
    'Classe le contenu d''un dossier par taille.' = 'Ranks the contents of a folder by size.'
    'dsize [dossier] [-Top <n>] [-Files] [-Json]' = 'dsize [folder] [-Top <n>] [-Files] [-Json]'
    'dossier' = 'folder'
    'Dossier à analyser (défaut : dossier courant)' = 'Folder to analyze (default: current folder)'
    'Nombre de lignes affichées (défaut : 15)' = 'Number of rows shown (default: 15)'
    'Liste les plus gros fichiers, tous sous-dossiers confondus' = 'Lists the largest files across all subfolders'
    'Sortie JSON, pour les scripts' = 'JSON output, for scripts'
    'dsize C:\Users\moi -Top 25' = 'dsize C:\Users\me -Top 25'
    'dsize D:\Projets -Files' = 'dsize D:\Projects -Files'
    'Dossier introuvable : {0}' = 'Folder not found: {0}'
    'Analyse : {0}' = 'Scanning: {0}'
    'Lecture impossible : {0}' = 'Cannot read folder: {0}'
    'contenu' = 'contents'
    'plus gros fichiers' = 'largest files'
    '{0} {1} {0} {2} fichier(s)' = '{0} {1} {0} {2} file(s)'
    'Dossier vide.' = 'Empty folder.'
    'Taille' = 'Size'
    'Part' = 'Share'
    'Nom' = 'Name'
    '... et {0} autre(s) élément(s) plus petits (-Top pour en voir davantage)' = '... and {0} smaller item(s) (use -Top to see more)'
    '{0} dossier(s) inaccessible(s) non comptabilisé(s)' = '{0} inaccessible folder(s) not counted'
    '{0} dossier(s) inaccessible(s) non comptabilisé(s) (un terminal administrateur en lira davantage)' = '{0} inaccessible folder(s) not counted (an administrator terminal can read more)'
